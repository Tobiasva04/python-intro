from flask import Flask, jsonify, request

app = Flask(__name__)

# Beispieldaten (Dictionary für Medien)
medien = {
    "1": {"name": "Der Herr der Ringe", "autor": "J.R.R. Tolkien", "kategorie": "Buch"},
    "2": {"name": "Inception", "autor": "Christopher Nolan", "kategorie": "Film"}
}

# 1. Liste aller Medien
@app.route('/medien', methods=['GET'])
def get_medien():
    return jsonify(medien)

# 2. Liste der Medien einer Kategorie
@app.route('/medien/<kategorie>', methods=['GET'])
def get_medien_by_kategorie(kategorie):
    medien_in_kategorie = {
        key: medium for key, medium in medien.items() if medium['kategorie'].lower() == kategorie.lower()
    }
    return jsonify(medien_in_kategorie)

# 3. Suche nach Medium mit exaktem Namen
@app.route('/medien/suche/<name>', methods=['GET'])
def suche_medium(name):
    for key, medium in medien.items():
        if medium['name'] == name:
            return jsonify({key: medium})
    return jsonify({"message": "Medium nicht gefunden"}), 404

# 4. Metadaten eines Mediums anzeigen
@app.route('/medien/details/<id>', methods=['GET'])
def get_medium_details(id):
    if id in medien:
        return jsonify(medien[id])
    return jsonify({"message": "Medium nicht gefunden"}), 404

# 5. Neues Medium erstellen
@app.route('/medien', methods=['POST'])
def create_medium():
    neues_medium = request.get_json()
    # TODO: Eindeutige ID generieren
    id = str(len(medien) + 1)
    medien[id] = neues_medium
    return jsonify({"message": "Medium erstellt", "id": id}), 201

# 6. Medium löschen
@app.route('/medien/<id>', methods=['DELETE'])
def delete_medium(id):
    if id in medien:
        del medien[id]
        return jsonify({"message": "Medium gelöscht"})
    return jsonify({"message": "Medium nicht gefunden"}), 404

if __name__ == '__main__':
    app.run(debug=True)
